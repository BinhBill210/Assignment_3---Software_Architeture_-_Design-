@page
@model YourOrderWeDeliver.Web.Pages.Quote.RespondModel
@{
    ViewData["Title"] = "Respond to a quote";
    var request = Model.DeliveryRequest;
    var quote = request?.Quote;
}

<h1 class="h3">Respond to a quote</h1>
<p class="text-muted">Enter the reference number from your request and the email address or phone number you used.</p>

<partial name="_ErrorSummary" />
@if (ViewData["Outcome"] is string outcome)
{
    <div class="alert alert-success">@outcome</div>
}

<form method="post" novalidate class="card mb-3"><div class="card-body">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label asp-for="Lookup.Reference" class="form-label"><span class="required">Reference number</span></label>
            <input asp-for="Lookup.Reference" class="form-control" placeholder="REQ-100001" />
            <span asp-validation-for="Lookup.Reference" class="field-validation-error"></span>
        </div>
        <div class="col-md-5">
            <label asp-for="Lookup.Contact" class="form-label"><span class="required">Email or phone number</span></label>
            <input asp-for="Lookup.Contact" class="form-control" />
            <span asp-validation-for="Lookup.Contact" class="field-validation-error"></span>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary w-100" asp-page-handler="Find">Find my quote</button>
        </div>
    </div>
</div></form>

@if (request is not null)
{
    <div class="card"><div class="card-body">
        <div class="d-flex justify-content-between">
            <h2 class="h5">Request @request.Reference</h2>
            <span class="badge @DisplayText.BadgeClass(request.Status) align-self-start">@DisplayText.Label(request.Status)</span>
        </div>
        <p class="mb-1">From <strong>@request.PickupAddress</strong> to <strong>@request.DestinationAddress</strong></p>
        <p class="text-muted small">@request.Parcels.Count parcel(s), total @request.TotalWeightKg kg</p>

        @if (quote is null)
        {
            <div class="alert alert-info mb-0">Your quote is not ready yet. Our office will prepare it shortly; please check back later.</div>
        }
        else
        {
            <table class="table w-auto">
                <tr><th>Delivery cost</th><td class="fs-5">@DisplayFormat.Money(quote.Cost)</td></tr>
                <tr><th>Estimated pickup</th><td>@DisplayFormat.DateAndTime(quote.Window.Start)</td></tr>
                <tr><th>Estimated delivery</th><td>@DisplayFormat.DateAndTime(quote.Window.End)</td></tr>
                <tr><th>Quote valid until</th><td>@DisplayFormat.DateAndTime(quote.ValidUntil)</td></tr>
            </table>

            @if (Model.CreatedDelivery is not null)
            {
                <p>Your delivery number is <strong>@Model.CreatedDelivery.Id</strong>. You can follow it on the
                    <a asp-page="/Track/Index">tracking page</a>.</p>
            }
            else if (quote.Response != QuoteResponse.Pending)
            {
                <div class="alert alert-secondary mb-0">
                    You @(quote.Response == QuoteResponse.Accepted ? "accepted" : "declined") this quote on @DisplayFormat.DateAndTime(quote.RespondedAt!.Value).
                </div>
            }
            else if (!Model.CanRespond)
            {
                <div class="alert alert-warning mb-0">This quote has expired. Please contact our office so it can be revised.</div>
            }
            else
            {
                <form method="post" novalidate>
                    <input type="hidden" asp-for="Lookup.Reference" />
                    <input type="hidden" asp-for="Lookup.Contact" />
                    <input type="hidden" name="quoteRevision" value="@quote.Revision" />
                    @if (Model.PendingChoice is bool accept)
                    {
                        <div class="alert @(accept ? "alert-success" : "alert-warning")">
                            @if (accept)
                            {
                                <text>Please confirm that you accept the quote of <strong>@DisplayFormat.Money(quote.Cost)</strong>. Payment is collected by our staff at pickup.</text>
                            }
                            else
                            {
                                <text>Please confirm that you want to decline this quote. The request will not proceed.</text>
                            }
                        </div>
                        <input type="hidden" name="accept" value="@accept.ToString()" />
                        <button type="submit" class="btn @(accept ? "btn-success" : "btn-danger")" asp-page-handler="Confirm">
                            Confirm: @(accept ? "accept quote" : "decline quote")
                        </button>
                        <button type="submit" class="btn btn-outline-secondary" asp-page-handler="Cancel">Go back</button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-success" asp-page-handler="Choose" asp-route-accept="true">Accept quote</button>
                        <button type="submit" class="btn btn-outline-danger" asp-page-handler="Choose" asp-route-accept="false">Decline quote</button>
                    }
                </form>
            }
        }
    </div></div>
}
