@page
@model YourOrderWeDeliver.Web.Pages.Office.Requests.IndexModel
@{
    ViewData["Title"] = "All requests";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">All requests</h1>
    <a class="btn btn-primary" asp-page="/Request/New">+ Record a request for a customer</a>
</div>

<div class="btn-group mb-3" role="group" aria-label="Filter by stage">
    <a class="btn btn-sm @(Model.Status is null ? "btn-secondary" : "btn-outline-secondary")"
        asp-page="Index"
        asp-route-status="">
            All (@Model.Counts.Values.Sum())
    </a>
    @foreach (var status in Enum.GetValues<RequestStatus>())
    {
        <a class="btn btn-sm @(Model.Status == status ? "btn-secondary" : "btn-outline-secondary")" asp-page="Index" asp-route-status="@status">
            @DisplayText.Label(status) (@Model.Counts[status])
        </a>
    }
</div>

@if (Model.Requests.Count == 0)
{
    <div class="alert alert-info">No requests at this stage.</div>
}
else
{
    <div class="card"><div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Reference</th>
                    <th>Customer</th>
                    <th>Pickup &rarr; destination</th>
                    <th>Parcels</th>
                    <th>Preferred date</th>
                    <th>Request stage</th>
                    <th>Delivery progress</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model.Requests)
                {
                    <tr>
                        <td class="fw-semibold">@request.Reference</td>
                        <td>@request.Customer.Name</td>
                        <td class="small">@request.PickupAddress.Suburb &rarr; @request.DestinationAddress.Suburb</td>
                        <td>@request.Parcels.Count (@request.TotalWeightKg kg)</td>
                        <td>@DisplayFormat.Day(request.PreferredPickupDate)</td>
                        <td><span class="badge @DisplayText.BadgeClass(request.Status)">@DisplayText.Label(request.Status)</span></td>
                        <td>
                            @if (request.Delivery is { } delivery)
                            {
                                <span class="badge @DisplayText.BadgeClass(delivery.Status)">
                                    @DisplayText.Label(delivery.Status)
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">Not started</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-page="Details" asp-route-reference="@request.Reference">
                                @(request.Status == RequestStatus.Submitted ? "Prepare quote" : "Open")
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div></div>
}
