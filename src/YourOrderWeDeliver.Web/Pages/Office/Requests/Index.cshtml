@page
@model YourOrderWeDeliver.Web.Pages.Office.Requests.IndexModel
@{
    ViewData["Title"] = "All requests";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">All requests</h1>
    <a class="btn btn-primary" asp-page="/Request/New">+ Record a request for a customer</a>
</div>

<form method="get" asp-page="Index" class="card mb-3">
    <div class="card-body">
        <input type="hidden" asp-for="Status" />

        <label asp-for="Search" class="form-label">Search by request ID</label>

        <div class="d-flex flex-wrap gap-2">
            <input asp-for="Search"
                   class="form-control"
                   style="max-width: 360px;"
                   placeholder="For example, REQ-100007 or 100007" />

            <button type="submit" class="btn btn-primary">Search</button>

            <a class="btn btn-outline-secondary"
               asp-page="Index"
               asp-route-status="@Model.Status"
               asp-route-search="">
                Clear search
            </a>
        </div>

        <p class="form-text mb-0">
            Enter a full or partial request ID.
            Search applies within the selected stage.
        </p>
    </div>
</form>

<div class="btn-group mb-3" role="group" aria-label="Filter by stage">
    <a class="btn btn-sm @(Model.Status is null ? "btn-secondary" : "btn-outline-secondary")"
        asp-page="Index"
        asp-route-status=""
        asp-route-search="@Model.Search">
            All (@Model.Counts.Values.Sum())
    </a>
    @foreach (var status in Enum.GetValues<RequestStatus>())
    {
        <a class="btn btn-sm @(Model.Status == status ? "btn-secondary" : "btn-outline-secondary")" asp-page="Index" asp-route-status="@status" asp-route-search="@Model.Search">
            @DisplayText.Label(status) (@Model.Counts[status])
        </a>
    }
</div>

@if (Model.Requests.Count == 0)
{
    <div class="alert alert-info">
        @if (!string.IsNullOrEmpty(Model.Search))
        {
            <span>
                No requests match "@Model.Search" within the selected stage.
                Try another ID, clear the search, or select All.
            </span>
        }
        else
        {
            <span>No requests at this stage.</span>
        }
    </div>
}
else
{
    <div class="card"><div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Reference</th>
                    <th>Customer</th>
                    <th>Pickup &rarr; destination</th>
                    <th>Parcels</th>
                    <th>Preferred date</th>
                    <th>Request stage</th>
                    <th>Delivery progress</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model.Requests)
                {
                    <tr>
                        <td class="fw-semibold">@request.Reference</td>
                        <td>@request.Customer.Name</td>
                        <td class="small">@request.PickupAddress.Suburb &rarr; @request.DestinationAddress.Suburb</td>
                        <td>@request.Parcels.Count (@request.TotalWeightKg kg)</td>
                        <td>@DisplayFormat.Day(request.PreferredPickupDate)</td>
                        <td><span class="badge @DisplayText.BadgeClass(request.Status)">@DisplayText.Label(request.Status)</span></td>
                        <td>
                            @if (request.Delivery is { } delivery)
                            {
                                <span class="badge @DisplayText.BadgeClass(delivery.Status)">
                                    @DisplayText.Label(delivery.Status)
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">Not started</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-page="Details" asp-route-reference="@request.Reference">
                                @(request.Status == RequestStatus.Submitted ? "Prepare quote" : "Open")
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div></div>
}
