@model YourOrderWeDeliver.Web.Models.AddressInput
@{
    string legend = (string)ViewData["Legend"]!;
}
<fieldset class="mb-3">
    <legend class="h6">@legend</legend>
    <div class="row g-2">
        <div class="col-md-6">
            <label asp-for="Street" class="form-label"><span class="required">Street address</span></label>
            <input asp-for="Street" class="form-control" placeholder="e.g. 12 Glenferrie Road" />
            <span asp-validation-for="Street" class="field-validation-error"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Suburb" class="form-label"><span class="required">Suburb</span></label>
            <input asp-for="Suburb" class="form-control" placeholder="e.g. Hawthorn" />
            <span asp-validation-for="Suburb" class="field-validation-error"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="Postcode" class="form-label"><span class="required">Postcode</span></label>
            <input asp-for="Postcode" class="form-control" inputmode="numeric" maxlength="4" placeholder="3122" />
            <span asp-validation-for="Postcode" class="field-validation-error"></span>
        </div>
    </div>
</fieldset>
