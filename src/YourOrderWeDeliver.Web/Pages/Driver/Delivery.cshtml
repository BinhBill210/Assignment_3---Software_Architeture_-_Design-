@page "{id?}"
@model YourOrderWeDeliver.Web.Pages.Driver.DeliveryModel
@{
    ViewData["Title"] = $"Delivery {Model.Id}";
    var delivery = Model.Delivery;
}

<p><a asp-page="Index">&larr; My deliveries</a></p>

@if (delivery is not null)
{
    var request = delivery.Request;
    bool allocated = delivery.Status == DeliveryStatus.Allocated;
    bool pickedUp = delivery.Status == DeliveryStatus.PickedUp;

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Delivery @delivery.Id</h1>
        <span class="badge fs-6 @DisplayText.BadgeClass(delivery.Status)">@DisplayText.Label(delivery.Status)</span>
    </div>

    <partial name="_ErrorSummary" />

    <div class="card mb-3"><div class="card-body">
        <div class="row">
            <div class="col-md-4"><strong>Window</strong><br />@DisplayFormat.Window(delivery.Window)</div>
            <div class="col-md-4"><strong>Pickup</strong><br />@request.PickupAddress</div>
            <div class="col-md-4"><strong>Destination</strong><br />@request.DestinationAddress</div>
        </div>
        <p class="mt-2 mb-0 small">
            Customer: @request.Customer.Name, @request.Customer.Phone
            @if (request.SpecialInstructions is not null)
            {
                <br /><strong>Instructions:</strong> @request.SpecialInstructions
            }
        </p>
    </div></div>

    <div class="card mb-3"><div class="card-body">
        <h2 class="h5">@(allocated ? "Step 1. Collect each parcel" : "Step 2. Deliver each parcel")</h2>
        <table class="table align-middle mb-0">
            <thead><tr><th>Parcel</th><th>Contents</th><th>Weight</th><th>Collected</th><th>Delivered</th><th></th></tr></thead>
            <tbody>
                @foreach (var parcel in delivery.Parcels)
                {
                    <tr>
                        <td>@parcel.Id</td>
                        <td>@parcel.Description @if (parcel.IsFragile) { <span class="badge text-bg-warning">Fragile</span> }</td>
                        <td>@parcel.WeightKg kg</td>
                        <td>@(parcel.CollectedAt is { } c ? DisplayFormat.TimeOfDay(c) : "–")</td>
                        <td>@(parcel.DeliveredAt is { } d ? DisplayFormat.TimeOfDay(d) : "–")</td>
                        <td class="text-end">
                            <form method="post" novalidate class="d-inline">
                                <input type="hidden" asp-for="Id" />
                                <input type="hidden" name="parcelId" value="@parcel.Id" />
                                @if (allocated && !parcel.IsCollected)
                                {
                                    <button type="submit" class="btn btn-sm btn-primary" asp-page-handler="Collect">Mark collected</button>
                                }
                                else if (allocated)
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" asp-page-handler="UndoCollect">Undo</button>
                                }
                                else if (pickedUp && !parcel.IsDelivered)
                                {
                                    <button type="submit" class="btn btn-sm btn-primary" asp-page-handler="Deliver">Mark delivered</button>
                                }
                                else if (pickedUp)
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" asp-page-handler="UndoDeliver">Undo</button>
                                }
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div></div>

    @if (allocated)
    {
        <form method="post" novalidate class="card mb-3"><div class="card-body">
            <h2 class="h5">Record pickup and payment</h2>
            <input type="hidden" asp-for="Id" />
            <p>Amount to collect: <strong class="fs-5">@DisplayFormat.Money(request.Quote!.Cost)</strong>
                <span class="small text-muted">(the accepted quote; this prototype records the payment only)</span></p>
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label asp-for="Method" class="form-label"><span class="required">Payment method</span></label>
                    <select asp-for="Method" class="form-select">
                        <option value="">-- choose --</option>
                        @foreach (var method in Enum.GetValues<PaymentMethod>())
                        {
                            <option value="@method">@DisplayText.Label(method)</option>
                        }
                    </select>
                    <span asp-validation-for="Method" class="field-validation-error"></span>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-success" asp-page-handler="Pickup">Record pickup</button>
                </div>
            </div>
            @if (delivery.CollectedParcelCount < delivery.Parcels.Count)
            {
                <p class="small text-muted mt-2 mb-0">Mark all @delivery.Parcels.Count parcel(s) as collected first (@delivery.CollectedParcelCount done).</p>
            }
        </div></form>
    }

    @if (pickedUp)
    {
        @if (Model.Receipt is { } receipt)
        {
            <div class="alert alert-success">
                Payment processed: @DisplayFormat.Money(receipt.Amount) by @DisplayText.Label(receipt.Method) at @DisplayFormat.DateAndTime(receipt.ReceivedAt) (receipt @receipt.Id).
            </div>
        }
        <form method="post" novalidate class="card mb-3"><div class="card-body">
            <h2 class="h5">Record completion</h2>
            <input type="hidden" asp-for="Id" />
            <div class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label asp-for="RecipientName" class="form-label"><span class="required">Received by</span></label>
                    <input asp-for="RecipientName" class="form-control" placeholder="Name of the person who signed" />
                    <span asp-validation-for="RecipientName" class="field-validation-error"></span>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-success" asp-page-handler="Complete">Complete delivery</button>
                </div>
            </div>
            @if (delivery.DeliveredParcelCount < delivery.Parcels.Count)
            {
                <p class="small text-muted mt-2 mb-0">Mark all @delivery.Parcels.Count parcel(s) as delivered first (@delivery.DeliveredParcelCount done).</p>
            }
        </div></form>
    }

    @if (delivery.Status != DeliveryStatus.Delivered)
    {
        <form method="post" novalidate class="card mb-3"><div class="card-body">
            <h2 class="h6">Report a problem</h2>
            <input type="hidden" asp-for="Id" />
            <div class="row g-2 align-items-end">
                <div class="col-md-9">
                    <label asp-for="IssueText" class="form-label visually-hidden">Issue</label>
                    <input asp-for="IssueText" class="form-control" placeholder="e.g. Nobody home at pickup, will retry at 2 pm" />
                    <span asp-validation-for="IssueText" class="field-validation-error"></span>
                </div>
                <div class="col-md-3"><button type="submit" class="btn btn-outline-danger w-100" asp-page-handler="ReportIssue">Report</button></div>
            </div>
        </div></form>
    }

    <div class="card"><div class="card-body">
        <h2 class="h6">History</h2>
        <ul class="timeline mb-0">
            @foreach (var entry in delivery.History)
            {
                <li class="@(entry.IsIssue ? "issue" : string.Empty)"><span class="small text-muted">@DisplayFormat.DateAndTime(entry.At)</span><br />@entry.Description</li>
            }
        </ul>
    </div></div>
}
